              <form onSubmit={handleSubmit(onSubmit)}
                className="flex flex-col gap-8">
                {/* Text Inputs */}
                {[
                  { name: "topic", label: "Subject Unit/Topic", required: true },
                  { name: "subTopic", label: "Subject Sub-Unit/Sub-Topic", required: false },
                ].map(({ name, label, required }) => (
                  <Controller key={name} name={name as keyof FormSchema}
                    control={control} render={({ field, fieldState }) => (
                      <FormItem>
                        <FormLabel>
                          {label} {required && <span className="text-red-500">*</span>}
                        </FormLabel>
                        <FormControl>
                          <Input {...field}
                            className="text-sm"
                            placeholder={`Enter ${label}`} />
                        </FormControl>
                        <FormMessage>{fieldState.error?.message}</FormMessage>
                      </FormItem>
                    )} />
                ))}
                <FormField
                  control={form.control}
                  name="aim"
                  render={({ field }) => (
                    <FormItem>
                      <FormLabel>Aim/Goal/Rationale                      </FormLabel>
                      <FormControl>
                        <Textarea {...field}
                          placeholder="Enter Aim/Goal/Rationale"
                          className="resize-none text-sm" />
                      </FormControl>
                      <FormMessage />
                    </FormItem>
                  )}
                />
                {/* Location and conditional State + LGA */}
                <div className="grid grid-cols-3 w-full gap-2">
                  <Controller name="location" control={control} render={({ field, fieldState }) => (
                    <div className="space-y-1 w-full">
                      <Label >Location <span className="text-red-500">*</span></Label>
                      <Select onValueChange={field.onChange}
                        value={typeof field.value === "string" ? field.value : ""}>
                        <SelectTrigger
                          className="w-full max-sm:text-sm">
                          <SelectValue placeholder="Select Location" />
                        </SelectTrigger>
                        <SelectContent>
                          {locationOptions.map(opt => <SelectItem key={opt} value={opt}>{opt}</SelectItem>)}
                        </SelectContent>
                      </Select>
                      <FormMessage>{fieldState?.error?.message}</FormMessage>
                    </div>
                  )} />
                  {selectedLocation === "Nigeria" && (
                    <Controller name="state" control={control} render={({ field }) => (
                      <div className="space-y-1 w-full">
                        <Label>State</Label>
                        <Select onValueChange={field.onChange} value={field.value || ""}>
                          <SelectTrigger
                            className="w-full">
                            <SelectValue placeholder="Select State "
                              className="w-full max-sm:text-sm"
                            /></SelectTrigger>
                          <SelectContent>
                            {nigeriaStates.map(opt => <SelectItem key={opt} value={opt}>{opt}</SelectItem>)}
                          </SelectContent>
                        </Select>
                      </div>
                    )} />
                  )}
                  {selectedState && lgasByState[selectedState] && (
                    <Controller name="lga" control={control} render={({ field }) => (
                      <div className="space-y-1 w-full">
                        <Label>LGA</Label>
                        <Select onValueChange={field.onChange} value={field.value || ""}>
                          <SelectTrigger
                            className="w-full">
                            <SelectValue placeholder="Select LGA"
                              className="w-full max-sm:text-sm" />
                          </SelectTrigger>
                          <SelectContent>
                            {lgasByState[selectedState].map(opt => <SelectItem key={opt} value={opt}>{opt}</SelectItem>)}
                          </SelectContent>
                        </Select>
                      </div>
                    )} />
                  )}
                </div>

                {/* Setting */}
                <Controller name="setting" control={control} render={({ field }) => (
                  <div className="space-y-1">
                    <Label>Setting</Label>
                    <Select onValueChange={field.onChange} value={field.value || ""}>
                      <SelectTrigger
                        className="w-full">
                        <SelectValue placeholder="Select Setting"
                          className="w-full max-sm:text-sm" />
                      </SelectTrigger>
                      <SelectContent>
                        {settings.map(opt => <SelectItem key={opt} value={opt}>{opt}</SelectItem>)}
                      </SelectContent>
                    </Select>
                  </div>
                )} />

                {/* School Branding */}
                {[{ name: "mission", label: "School Branding - Mission	" }
                  , { name: "vision", label: "School Branding - Vision	" },
                { name: "coreValues", label: "School Branding - Core Values	" }].map(({ name, label }) => (
                  <Controller key={name} name={name as keyof FormSchema}
                    control={control} render={({ field }) => (
                      <div className="space-y-1">
                        <Label>{label}</Label>
                        <Textarea {...field} placeholder={`Enter ${name}`}
                          className="resize-none max-sm:text-sm" />
                      </div>
                    )} />
                ))}
                {/* subject dicipline */}
                <FormField
                  control={control}
                  name="subjectDicipline"
                  render={({ field }) => (
                    <FormItem>
                      <FormLabel>Subject Discipline
                        <span className="text-red-500">*</span>
                      </FormLabel>
                      <FormControl>
                        <Select onValueChange={field.onChange}
                          value={field.value} defaultValue={field.value}>
                          <SelectTrigger className="w-full">
                            <SelectValue placeholder="Select Subject Discipline"
                              className="max-sm:text-sm" />
                          </SelectTrigger>
                          <SelectContent>
                            {subjectDiscipline.map((opt, index) =>
                              <SelectItem key={index} value={opt}>{opt}</SelectItem>)}
                          </SelectContent>
                        </Select>
                      </FormControl>
                      <FormMessage />
                    </FormItem>
                  )}
                />
                {/* week */}
                <FormField
                  control={control}
                  name="week"
                  render={({ field }) => (
                    <FormItem>
                      <FormLabel>Week
                        <span className="text-red-500">*</span>
                      </FormLabel>
                      <FormControl>
                        <Select onValueChange={field.onChange}
                          value={field.value} defaultValue={field.value}>
                          <SelectTrigger className="w-full">
                            <SelectValue placeholder="Select Subject Discipline"
                              className="max-sm:text-sm" />
                          </SelectTrigger>
                          <SelectContent>
                            {weekList.map((opt, index) =>
                              <SelectItem key={index} value={opt}>{opt}</SelectItem>)}
                          </SelectContent>
                        </Select>
                      </FormControl>
                      <FormMessage />
                    </FormItem>
                  )}
                />

                {/* Single Selects */}
                <div className="grid grid-cols-2 gap-6 justify-start items-center">
                  {[
                    { name: "curriculum", label: "Curriculum / Scheme / Scheme of Work Type", required: true, options: curriculumTypes },
                    { name: "yearClass", label: "Year/Grade/Class", required: true, options: yearClasses },
                    { name: "term", options: termOptions },
                    { name: "subject", label: "Subject", options: subjects },
                    { name: "bloomLevel", label: "Level of Difficulty (Bloom’s Taxonomy)", options: bloomLevels },
                    { name: "classSize", options: classSizes, label: "Class Size" },
                    { name: "timeAvailable", label: "Time Available", options: timeOptions },
                    { name: "technologyAccess", label: "Availability / Access of Technology", options: ["Yes", "No"] },
                    { name: "lessonNotes", options: ["Yes", "No"], label: "Lesson Notes" },
                    { name: "assessmentType", label: "Assessment Type", options: ["Diagnostic", "Formative", "Summative"] }]
                    .map(({ name, options, label }) => (
                      <Controller key={name}
                        name={name as keyof FormSchema}
                        control={control}
                        render={({ field, fieldState }) => (
                          <div className="space-y-1">
                            <Label className="leading-4">{(name === "curriculum" || name === "yearClass"
                              || name === "term"
                              || name === "subject" || name === "bloomLevel"
                              || name === "classSize"
                              || name === "timeAvailable"
                              || name === "technologyAccess") ? <>
                              {label ? label : `${name.charAt(0).toUpperCase()}${name.slice(1)}`}
                              {/* {name && } */}
                              <span className="text-red-500">*</span>
                              {/* <span className="text-red-500">*</span> */}
                            </> : name.charAt(0).toUpperCase() + name.slice(1)}</Label>
                            <Select onValueChange={field.onChange}
                              value={typeof field.value === "string" ? field.value : ""}>
                              <SelectTrigger
                                className="w-full">
                                <SelectValue placeholder={`Select ${name}`}
                                  className="max-sm:text-sm" />
                              </SelectTrigger>
                              <SelectContent>
                                {options.map(opt => <SelectItem key={opt} value={opt}>{opt}</SelectItem>)}
                              </SelectContent>
                            </Select>
                            <FormMessage>{fieldState.error?.message}</FormMessage>
                          </div>
                        )} />
                    ))}
                </div>

                {/* Multi-selects */}
                <div className="flex flex-col gap-3">
                  <Label>SPECIAL EDUCATION NEEDS (SEN) DIFFERENTIATION</Label>
                  <div className="grid grid-cols-2 gap-5">
                    {senTypes.map(opt => (
                      <div key={opt} className="flex items-center space-x-2">
                        <label key={opt}
                          className="flex items-center
                        space-x-2 cursor-pointer max-sm:leading-7">
                          <Checkbox className="data-[state=checked]:bg-yellow-500"
                            checked={watch("sen")?.includes(opt)}
                            onCheckedChange={checked => {
                              const prev = watch("sen") || [];
                              if (checked) setValue("sen", [...prev, opt]);
                              else setValue("sen", prev.filter(v => v !== opt));
                            }}
                          />
                          <FormLabel>{opt}</FormLabel>
                        </label>
                      </div>
                    ))}
                  </div>
                </div>

                {/* preRequisite */}
                <FormField
                  control={form.control}
                  name="preRequisite"
                  render={({ field }) => (
                    <FormItem>
                      <FormLabel>Pre-requisite Competence (Knowledge, Skills, Attitude)
                      </FormLabel>
                      <FormControl>
                        <Textarea {...field}
                          placeholder="Describe the required knowledge, skills, and attitudes needed before this unit"
                          className="resize-none max-sm:text-sm" />
                      </FormControl>
                      <FormMessage />
                    </FormItem>
                  )}
                />

                <div className="flex flex-col gap-3">
                  <FormLabel
                    className="leading-4">Availability of Teaching Aids / Learning Resources
                    / Instructional Materials <span className="text-red-500">*</span> </FormLabel>
                  <FormField
                    control={control}
                    name="teachingAids"
                    render={({ field }) => (
                      <FormItem>
                        <div className="grid grid-cols-2 gap-5">
                          {teachingAids.map((item) => (
                            <FormItem key={item} className="flex flex-row items-center space-x-2 space-y-0">
                              <FormControl>
                                <Checkbox
                                  className="data-[state=checked]:bg-yellow-500"
                                  checked={field.value?.includes(item)}
                                  onCheckedChange={(checked) => {
                                    const newValue = checked
                                      ? [...(field.value || []), item]
                                      : field.value?.filter(value => value !== item) || [];
                                    field.onChange(newValue);
                                  }}
                                />
                              </FormControl>
                              <FormLabel>
                                {item}
                              </FormLabel>
                            </FormItem>
                          ))}
                        </div>
                        <FormMessage />
                      </FormItem>
                    )}
                  />
                </div>
                <Button type="submit" variant={"primary"}><Wand /> Generate Lesson Plan</Button>
              </form>