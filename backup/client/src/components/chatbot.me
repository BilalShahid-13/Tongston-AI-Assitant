import { useState, useRef, useEffect } from 'react'
import { Bot, SendHorizonal, UserRound } from 'lucide-react'
import { Input } from '@/components/ui/input'
import { Button } from '@/components/ui/button'

type Message = {
  id: string
  text: string
  sender: 'user' | 'bot'
  timestamp: Date
}

export default function AIAssistant({ chats }: { chats: string }) {
  const [messages, setMessages] = useState<Message[]>([
    {
      id: '1',
      text: 'Hello! I\'m ready to help you create an amazing lesson plan. Please fill out the form, and I\'ll generate a comprehensive plan aligned with educational best practices.',
      sender: 'bot',
      timestamp: new Date(),
    },
    {
      id: '2',
      text: 'Ask me anything about lesson planning...',
      sender: 'bot',
      timestamp: new Date(),
    }
  ])

  const [inputValue, setInputValue] = useState('')
  const messagesEndRef = useRef<HTMLDivElement>(null)
  const messagesContainerRef = useRef<HTMLDivElement>(null)

  const handleSendMessage = () => {
    if (!inputValue.trim()) return

    // Add user message
    const userMessage: Message = {
      id: Date.now().toString(),
      text: inputValue,
      sender: 'user',
      timestamp: new Date(),
    }
    setMessages((prev) => [...prev, userMessage])
    setInputValue('')

    // Simulate bot response
    setTimeout(() => {
      const botResponses = [
        "For your photosynthesis lesson, I recommend including a hands-on experiment with leaves and sunlight.",
        "Based on Bloom's Taxonomy, here are some questions you could ask about plant biology...",
        "For your class size of 25, consider breaking students into 5 groups of 5 for activities.",
        "I can align this lesson with the Nigerian curriculum standards for biology.",
        "Would you like me to suggest some formative assessment questions?"
      ]

      const botMessage: Message = {
        id: Date.now().toString(),
        text: botResponses[Math.floor(Math.random() * botResponses.length)],
        sender: 'bot',
        timestamp: new Date(),
      }
      setMessages((prev) => [...prev, botMessage])
    }, 800)
  }

  const handleKeyDown = (e: React.KeyboardEvent) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault()
      handleSendMessage()
    }
  }

  // Auto-scroll to bottom
  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' })
  }, [messages])

  return (
    <div className="flex flex-col border rounded-lg bg-card shadow-sm h-[75vh]">
      {/* Messages container with scroll */}
      <div
        ref={messagesContainerRef}
        className="flex-1 overflow-y-auto p-4 pb-20" // Extra padding at bottom for input
      >
        {/* {messages.map((message, index) => (
          <div
            key={index}
            className={`mb-4 flex items-start gap-2 ${message.sender === 'user' ? 'justify-end' : 'justify-start'}`}
          >
            {message.sender === 'bot' && (
              <div className="flex-shrink-0 mt-1">
                <Bot className="h-4 w-4 text-muted-foreground" />
              </div>
            )}
            <div
              className={`max-w-[80%] px-3 py-2 rounded-lg text-sm ${message.sender === 'user'
                ? 'bg-yellow-400 text-zinc-800'
                : 'bg-muted text-muted-foreground'
                }`}
            >
              {message.text}
            </div>
            {message.sender === 'user' && (
              <div className="flex-shrink-0 mt-1">
                <UserRound className="h-4 w-4 text-muted-foreground" />
              </div>
            )}
          </div>
        ))} */}
        <span>{chats}</span>
        <div ref={messagesEndRef} />
      </div>

      {/* Sticky input container */}
      <div className="sticky bottom-0 border-t bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 p-3">
        <div className="flex items-center gap-2">
          <Input
            value={inputValue}
            onChange={(e) => setInputValue(e.target.value)}
            onKeyDown={handleKeyDown}
            placeholder="Ask about lesson planning..."
            className="flex-1 rounded-full"
          />
          <Button
            onClick={handleSendMessage}
            disabled={!inputValue.trim()}
            size="icon"
            className="rounded-full bg-yellow-400 hover:bg-yellow-500 text-zinc-800"
          >
            <SendHorizonal className="h-4 w-4" />
          </Button>
        </div>
      </div>
    </div>
  )
}