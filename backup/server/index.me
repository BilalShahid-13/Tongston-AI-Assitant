




import { RecursiveCharacterTextSplitter } from "@langchain/textsplitters";
import cors from "cors";
import dotenv from "dotenv";
import express from "express";
import { Db } from "mongodb";
import { connectMongo } from "./lib/connectDb";
import { loadPdfText } from "./lib/loadPdf";
import openai from "./lib/openai";
import { fetchPdfUrls } from "./utils/fetchPdfs";
import { parseExcelFile } from "./utils/parseExcelFile";
import { insertKnowledgeBase } from "./lib/insertKnowledgeBase";

dotenv.config();
const app = express();

const COLLECTION_NAME = process.env.COLLECTION_NAME as string;
const folderId = "1pgJGQyx6DGWChKnl0oTK4sDDoHmIgiiA";

app.use(express.json());
app.use(cors({ origin: "*" }));

const splitter = new RecursiveCharacterTextSplitter({
  chunkSize: 512,
  chunkOverlap: 100
});

// ⛳ Fixed: Load data properly after DB is connected
const loadData = async (db: Db) => {
  const collection = db.collection(COLLECTION_NAME);
  const files = await fetchPdfUrls(folderId);

  for await (const file of files) {
    const content = await loadPdfText(file.url);
    const chunks = await splitter.splitText(content);

    for await (const chunk of chunks) {
      const embedding = await openai.embeddings.create({
        model: "text-embedding-3-small",
        input: chunk,
        encoding_format: "float"
      });

      const vector = embedding.data[0].embedding;

      await collection.insertOne({
        fileName: file.name,
        source: file.url,
        content: chunk,
        $vector: vector, // Only usable in MongoDB Atlas with vector index
        createdAt: new Date(),
      });
    }

    console.log(`✅ Processed: ${file.name}`);
  }
};

(async () => {
  try {
    const db = await connectMongo();
    console.log("✅ Connected to MongoDB");
    // const file = await parseExcelFile();
    // const file = parseExcelFile("./public/AI Chatbot (K12) Knowledge base sort sheet.xlsx");
    const file = insertKnowledgeBase("./public/AI Chatbot (K12) Knowledge base sort sheet.xlsx");
    // await loadData(db);
    if (file && Array.isArray(file)) {
      console.log(file[3]);
    } else {
      console.log("No file data loaded.");
    }

    app.listen(3000, () => {
      console.log("🚀 Server started at http://localhost:3000");
    });
  } catch (error) {
    console.error("❌ Error starting server or loading data:", error);
  }
})();
