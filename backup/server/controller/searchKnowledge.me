async function searchKnowledgeBase(req: Request, res: Response): Promise<void> {
  const {
    query,
    bloomLevel,
    classSize,
    classesSocioEconomic,
    curriculum,
    location,
    schoolLevel,
    studentAge,
    subSchoolLevel,
    subject,
    subjectDicipline,
    term,
    termTheme,
    timeAvailable,
    week,
    yearClass,
  } = req.body;

  // Set headers for streaming response
  res.setHeader("Content-Type", "text/event-stream");
  res.setHeader("Cache-Control", "no-cache");
  res.setHeader("Connection", "keep-alive");

  try {
    const queryEmbedding = await generateEmbedding(
      [
        bloomLevel,
        classSize,
        classesSocioEconomic,
        curriculum,
        location,
        schoolLevel,
        studentAge,
        subSchoolLevel,
        subject,
        subjectDicipline,
        term,
        termTheme,
        timeAvailable,
        week,
        yearClass,
      ]
        .filter(Boolean)
        .join(" ")
    );

    const collection = await connectMongo();
    const documents = await collection.find({}).toArray();

    if (documents.length === 0) {
      res.status(404);
      res.write(
        `data: ${JSON.stringify({
          error: "No documents found in the collection",
        })}\n\n`
      );
      res.end(); // Terminate the response stream
      return;
    }

    const similarites = documents.map((doc: any) => {
      const similarity = cosineSimilarity(queryEmbedding, doc.embedding);
      return {
        ...doc,
        similarity,
      };
    });

    similarites.sort((a: any, b: any) => b.similarity - a.similarity);

    let prompt: string;
    if (similarites.length === 0 || similarites[0].similarity < 0.5) {
      prompt = query;
    } else {
      prompt = `${prompts.lessonPlanPrompts.prompt}\n
        Discipline: ${similarites[0].Discipline},
        subject: ${similarites[0].Subjects},
        class: ${similarites[0].Class},
        Description: ${similarites[0].Description},
        source: ${similarites[0].source},`;
    }

    const stream = await OpenAIStream(prompt);

    for await (const chunk of stream) {
      // Write each streamed chunk to the response
      res.write(chunk.choices?.[0]?.delta?.content || "");
    }
    res.end();
  } catch (error: any) {
    res.status(500);
    res.write(
      `data: ${JSON.stringify({
        error:
          "Server error during search: " + (error.message || "Unknown error"),
      })}\n\n`
    );
    res.end(); // Important: Terminate the response stream on error
  }
}

export { searchKnowledgeBase };
















import { OpenAIEmbeddings } from "@langchain/openai";
import { MongoDBAtlasVectorSearch } from "@langchain/mongodb";
import { MongoClient } from "mongodb";
import { ChatOpenAI } from "@langchain/openai";
import { StringOutputParser } from "@langchain/core/output_parsers";
import { RunnableSequence } from "@langchain/core/runnables";
import { PromptTemplate } from "@langchain/core/prompts";

import { Request, Response } from "express";
import { prompts } from "../lib/constant";

async function searchKnowledgeBase(req: Request, res: Response): Promise<void> {
  const {
    query,
    bloomLevel,
    classSize,
    classesSocioEconomic,
    curriculum,
    location,
    schoolLevel,
    studentAge,
    subSchoolLevel,
    subject,
    subjectDicipline,
    term,
    termTheme,
    timeAvailable,
    week,
    yearClass,
  } = req.body as {
    query?: string;
    bloomLevel?: string;
    classSize?: string;
    classesSocioEconomic?: string;
    curriculum?: string;
    location?: string;
    schoolLevel?: string;
    studentAge?: string;
    subSchoolLevel?: string;
    subject?: string;
    subjectDicipline?: string;
    term?: string;
    termTheme?: string;
    timeAvailable?: string;
    week?: string;
    yearClass?: string;
  };

  // Set headers for streaming response
  res.setHeader("Content-Type", "text/event-stream");
  res.setHeader("Cache-Control", "no-cache");
  res.setHeader("Connection", "keep-alive");

  try {
    // Initialize MongoDB connection
    const client = new MongoClient(process.env.MONGODB_URI!);
    await client.connect();

    const db = client.db(process.env.MONGODB_DATABASE);
    const collection = db.collection(process.env.DB_NAME!);

    // Create vector store
    const vectorStore = new MongoDBAtlasVectorSearch(
      new OpenAIEmbeddings({
        modelName: "text-embedding-3-small", // or your preferred embedding model
      }),
      {
        collection,
        indexName: "vector_index", // your vector index name
        textKey: "text", // the field containing the text
        embeddingKey: "embedding", // the field containing the embedding
      }
    );

    // Generate query from all non-empty parameters
    const searchQuery = [
      bloomLevel,
      classSize,
      classesSocioEconomic,
      curriculum,
      location,
      schoolLevel,
      studentAge,
      subSchoolLevel,
      subject,
      subjectDicipline,
      term,
      termTheme,
      timeAvailable,
      week,
      yearClass,
    ]
      .filter(Boolean)
      .join(" ");

    // Perform similarity search
    const results = await vectorStore.similaritySearch(searchQuery, 3, {
      preFilter: {
        // Add any MongoDB filter conditions here if needed
        // For example: schoolLevel: "High School"
      },
    });

    if (results.length === 0) {
      res.status(404);
      res.write(
        `data: ${JSON.stringify({
          error: "No documents found in the collection",
        })}\n\n`
      );
      res.end();
      return;
    }

    // Initialize LLM with streaming enabled
    const model = new ChatOpenAI({
      modelName: "gpt-4", // or your preferred model
      temperature: 0.7,
      streaming: true,
    });

    // Create prompt template
    const promptTemplate = PromptTemplate.fromTemplate(`
      {prompt}

      Based on the following context:
      {context}

      Generate a comprehensive response that addresses the original query: {query}
    `);

    // Prepare context from search results
    const context = results.map((doc) =>
      `Discipline: ${doc.metadata.Discipline},
       Subject: ${doc.metadata.Subjects},
       Class: ${doc.metadata.Class},
       Description: ${doc.metadata.Description},
       Source: ${doc.metadata.source}`
    ).join("\n\n");

    // Create the chain
    const chain = RunnableSequence.from([
      {
        prompt: () => prompts.lessonPlanPrompts.prompt,
        context: () => context,
        query: () => query,
      },
      promptTemplate,
      model,
      new StringOutputParser(),
    ]);

    // Stream the response
    const stream = await chain.stream({});

    for await (const chunk of stream) {
      res.write(chunk);
    }

    res.end();
  } catch (error: any) {
    res.status(500);
    res.write(
      `data: ${JSON.stringify({
        error: "Server error during search: " + (error.message || "Unknown error"),
      })}\n\n`
    );
    res.end();
  }
}
export { searchKnowledgeBase };
